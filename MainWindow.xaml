<Window x:Class="ClinicApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="МИС «Частная поликлиника»" Height="760" Width="1250" MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="#F1F5F9">
  <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Background="#0F4C81"><DockPanel Margin="22,0"><TextBlock Text="✚  МИС «ЧАСТНАЯ ПОЛИКЛИНИКА»" Foreground="White" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="UserText" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"/></DockPanel></Border>
    <Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="8" Padding="8"><StackPanel>
        <Button Content="Пациенты" Tag="patients" Click="Menu_Click"/><Button Content="Врачи" Tag="doctors" Click="Menu_Click"/><Button Content="Осмотры" Tag="visits" Click="Menu_Click"/><Button Content="Лекарства" Tag="medicines" Click="Menu_Click"/><Button Content="Назначения" Tag="prescriptions" Click="Menu_Click"/><Button Content="Отчёты" Tag="reports" Click="Menu_Click"/><Button x:Name="UsersButton" Content="Пользователи" Tag="users" Click="Menu_Click"/><Button x:Name="AuditButton" Content="Журнал аудита" Tag="audit" Click="Menu_Click"/>
        <Separator Margin="5,16"/><Button Content="Выход" Click="Logout_Click"/>
      </StackPanel></Border>
      <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" Padding="10"><DockPanel><TextBlock x:Name="TitleText" Text="Пациенты" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="230" ToolTip="Поиск" KeyDown="SearchBox_KeyDown"/><Button Content="Найти" Click="Search_Click"/><Button x:Name="AddButton" Content="Добавить" Click="Add_Click"/><Button x:Name="EditButton" Content="Изменить" Click="Edit_Click"/><Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click"/><Button Content="Печать" Click="Print_Click"/></StackPanel></DockPanel></Border>
        <DataGrid x:Name="MainGrid" Grid.Row="1" Margin="0,12" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="MainGrid_SelectionChanged" AlternatingRowBackground="#EFF6FF"/>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border BorderBrush="#CBD5E1" BorderThickness="1"><Image x:Name="PhotoImage" Stretch="Uniform"/></Border><TextBlock x:Name="DetailsText" Grid.Column="1" Margin="18,0" Text="Выберите запись для просмотра подробностей" TextWrapping="Wrap" FontSize="14"/></Grid></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#E2E8F0"><TextBlock x:Name="StatusText" Margin="18,0" VerticalAlignment="Center" Foreground="#475569"/></Border>
  </Grid>
</Window>
